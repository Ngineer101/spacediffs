{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spacediffs",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
}
